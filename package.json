{
  "name": "pions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./formal-review": "./dist/src/formal-review.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.extension.json",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-unknown",
    "check:test-assertions": "npm run build:test --silent && node .test-dist/scripts/check-test-assertions.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:test-assertions && npm test",
    "test": "npm run build:test && node --test --test-reporter=dot .test-dist/test/*.test.js",
    "build:test": "rm -rf .test-dist && tsc --outDir .test-dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "effect": "3.22.1",
    "pi-claude-bridge": "0.7.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/parser": "8.0.4",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
